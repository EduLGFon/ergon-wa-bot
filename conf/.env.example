# .env: Here I keep sensitive content like keys, IDs, IPs, etc
# and other environment variables
TZ='America/Sao_Paulo' # timezone

# ========== { Database } ==========
# Drizzle supports PostgreSQL, MySQL, SQLite and others,
# but I use PostgreSQL and some things could not be easy to set up on other DBs.
# DATABASE_URL='postgresql://role:password@host:port/db'



# ========== { BOT } ========== 
# Bot developers/owners lid
# split every lid by a |
DEVS='lid01|lid02|lid03'

# group Ids for group announcement 
# split every id by a |
GROUPS1='' # Groups to be announced by #diurno
GROUPS2='' # and by #noturno
#grupos will announce to all these groups
# DEV-only menu test target (used instead of GROUPS1/GROUPS2 when DEV=1).
# GROUPS0=''


# ========== { Optional } ==========
# These keys are only necessary to specific things.
# Google Gemini API is necessary to use AI generate content features
GEMINI='get a key on https://aistudio.google.com/app/apikey'

# ========== { Telegram bridge } ==========
# Required to mirror WhatsApp chats into Telegram forum supergroups.
# TELEGRAM_BOT_TOKEN='123:abc'
# Personal and business chats live in separate supergroups (same bot in
# both). Each falls back to TELEGRAM_SUPERGROUP_ID, so a single-group
# setup keeps working untouched.
TELEGRAM_BOT_TOKEN='telegram bot token'
TELEGRAM_SUPERGROUP_ID='telegram supergroup id for uncategorized chats'
TELEGRAM_SUPERGROUP_PERSONAL='telegram supergroup id for personal chats'
TELEGRAM_SUPERGROUP_BUSINESS='telegram supergroup id for business chats'
# Optional: your numeric Telegram user id for @all/@mention pings. When unset
# the bridge uses the personal supergroup creator instead.
# TELEGRAM_OWNER_ID='123456789'
# Optional: attribute every WA reaction with its author in an edited summary
# message beside the mirror (default off, most popular emoji lands on the
# message either way).
# BRIDGE_REACTION_SUMMARY='true'
RATE_LIMIT_MS=3000
# Personal-lane priority: Telegram throttles per supergroup, so personal
# and business have separate queues. Defaults keep both lanes equal;
# raise the business spacing (e.g. 8000) to shed business load harder
# while personal stays real-time. A business 429 never stalls personal.
# TELEGRAM_RATE_LIMIT_MS_PERSONAL=3000
# TELEGRAM_RATE_LIMIT_MS_BUSINESS=8000
