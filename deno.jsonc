{
	"fmt": {
		"indentWidth": 4,
		"singleQuote": true,
		"useTabs": true,
		"semiColons": false,
		"lineWidth": 100,
		"exclude": [
			"conf/gen/python",
			"conf/gen/auth",
			"conf/gen/temp",
			"conf/gen/prisma"
		]
	},
	"lint": {
		"rules": {
			"exclude": [
				"no-explicit-any",
				"no-import-prefix",
				"no-unversioned-import"
			]
		}
	},
	"imports": {
		"@google/genai": "npm:@google/genai@^2.11.0",
		"baileys": "npm:@whiskeysockets/baileys",
		"google-translate-api-x": "npm:google-translate-api-x@^10.7.3",
		"humanize-duration": "npm:humanize-duration@^3.34.0",
		"i18next": "npm:i18next@^26.3.6",
		"i18next-fs-backend": "npm:i18next-fs-backend@^2.6.6",
		"node-webpmux": "npm:node-webpmux@^3.2.1",
		"sharp": "npm:sharp@^0.33.0",
		"@types/node": "npm:@types/node@^25.9.5",
		"drizzle-orm": "npm:drizzle-orm",
		"drizzle-kit": "npm:drizzle-kit",
		"postgres": "npm:postgres",
		"@std/log": "jsr:@std/log",
		"@std/datetime": "jsr:@std/datetime",
		"@libs/qrcode": "jsr:@libs/qrcode",
		"@class/": "./class/",
		"@cmd/": "./cmd/",
		"@conf/": "./conf/",
		"@event/": "./event/",
		"@plugin/": "./plugin/",
		"@util/": "./util/",
		"@db": "./plugin/db.ts",
		"@wa": "./wa.ts"
	},
	"unstable": ["cron"],
	"tasks": {
		"presetup": "deno install -g npm:drizzle-kit npm:pm2",
		"setup": "deno task presetup && deno install && echo light setup complete",
		"setup:medium": "deno task presetup && deno install && deno task setup:py && echo medium setup complete",
		"setup:strong": "deno task presetup && deno task db:push && deno install && deno task setup:py && echo strong setup complete",
		"setup:py": "python3 -m venv conf/gen/python && conf/gen/python/bin/pip install rembg onnxruntime yt-dlp[default,curl-cffi]",
		"wizard": "deno run -A setup.ts",
		"update": "git pull origin master; deno task presetup; deno install; deno upgrade; deno task update:py; deno task postinstall",
		"update:py": "conf/gen/python/bin/pip install -U rembg onnxruntime yt-dlp[default,curl-cffi]",
		"postinstall": "deno task db:gen",
		"start": "pm2 start conf/ecosystem.config.cjs --attach",
		"start:dev": "NODE_EXTRA_CA_CERTS=conf/smufesrootca.pem deno run -A --env=conf/.env wa.ts",
		"restart": "pm2 restart wa --attach",
		"stop": "pm2 delete wa",
		"db:gen": "deno run -A npm:drizzle-kit generate",
		"db:push": "deno run -A npm:drizzle-kit push",
		"db:pull": "deno run -A npm:drizzle-kit introspect",
		"reset": "rm -r conf/gen/auth/* conf/gen/cache/* conf/gen/temp/*",
		"fmt": "deno fmt",
		"dev": "deno task stop; DEV=1 pm2 start conf/ecosystem.config.cjs --attach",
		"translate": "deno run -A npm:@parvineyvazov/json-translator locale/pt.json -m google -f pt -t en es fr de"
	},
	"compilerOptions": {
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"strict": true,
		"skipLibCheck": false,
		"types": [
			"./conf/types/global.d.ts"
		]
	},
	"nodeModulesDir": "auto",
	"allowScripts": [
		"npm:@google/genai@2.13.0",
		"npm:@whiskeysockets/baileys@7.0.0-rc13",
		"npm:protobufjs@7.6.5",
		"npm:sharp@0.30.7",
		"npm:sharp@0.33.5"
	]
}
