{
	"fmt": {
		"indentWidth": 4,
		"singleQuote": true,
		"useTabs": true,
		"semiColons": false,
		"lineWidth": 100
	},
	"lint": {
		"rules": {
			"exclude": ["no-explicit-any", "no-import-prefix", "no-unversioned-import"]
		}
	},
	"imports": {
		"@google/genai": "npm:@google/genai@^2.32.0",
		"baileys": "npm:@whiskeysockets/baileys@^7.0.0-rc14",
		"grammy": "npm:grammy@^1.46.0/web",
		"i18next": "npm:i18next@^26.5.12",
		"node-webpmux": "npm:node-webpmux@^3.2.1",
		"sharp": "npm:sharp@^0.35.5",
		"@types/node": "npm:@types/node@^26.6.6",
		"drizzle-orm": "npm:drizzle-orm@^0.45.4",
		"drizzle-orm/": "npm:/drizzle-orm@^0.45.4/",
		"drizzle-kit": "npm:drizzle-kit@^0.31.11",
		"postgres": "npm:postgres@^4.0.0",
		"@libs/qrcode": "jsr:@libs/qrcode@^3.1.0",
		"@class/": "../../class/",
		"@cmd/": "../../cmd/",
		"@conf/": "../../conf/",
		"@event/": "../../event/",
		"@plugin/": "../../plugin/",
		"@util/": "../../util/",
		"@db": "../../plugin/db.ts",
		"@wa": "../../wa.ts"
	},
	"compilerOptions": {
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"strict": true,
		"skipLibCheck": false,
		"types": ["../../conf/types/global.d.ts"]
	},
	"nodeModulesDir": "auto",
	"minimumDependencyAge": 0,
	"allowScripts": [
		"npm:@whiskeysockets/baileys@7.0.0-rc14",
		"npm:@google/genai@2.32.0",
		"npm:protobufjs@7.6.6",
		"npm:esbuild@0.28.2"
	]
}
