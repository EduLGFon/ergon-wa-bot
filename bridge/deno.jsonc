{
	"fmt": {
		"indentWidth": 4,
		"singleQuote": true,
		"useTabs": true,
		"semiColons": false,
		"lineWidth": 100
	},
	"lint": {
		"rules": {
			"exclude": ["no-explicit-any", "no-import-prefix", "no-unversioned-import"]
		}
	},
	"imports": {
		"baileys": "npm:@whiskeysockets/baileys@7.0.0-rc14",
		"grammy": "npm:grammy@1.36.0",
		"drizzle-orm": "npm:drizzle-orm@0.45.2",
		"postgres": "npm:postgres@3.4.9",
		"@std/fs": "jsr:@std/fs@1.0.0"
	},
	"compilerOptions": {
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"strict": true,
		"skipLibCheck": false,
		"types": ["../conf/types/global.d.ts"]
	},
	"nodeModulesDir": "auto"
}
